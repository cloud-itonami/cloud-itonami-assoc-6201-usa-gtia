(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count topic by-topic-count by-topic-id]))
(defn association-covered? [a :string] :bool (string=? a "gtia"))
(defn entry-count [a :string] :i64 (if (association-covered? a) 2 0))
(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (= i 0) true (if (= i 1) true false)) false))
(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "gtia.about-us")
        (string=? f "title") (option-some-of [:option :string] "About Us")
        (string=? f "association") (option-some-of [:option :string] "gtia")
        (string=? f "isic") (option-some-of [:option :string] "6201")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "governance-program")
        (string=? f "url") (option-some-of [:option :string] "https://gtia.org/about-us")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "1982")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-16")
        :else (option-none-of [:option :string]))
      (cond
        (string=? f "id") (option-some-of [:option :string] "gtia.code-of-conduct")
        (string=? f "title") (option-some-of [:option :string] "Code of Conduct")
        (string=? f "association") (option-some-of [:option :string] "gtia")
        (string=? f "isic") (option-some-of [:option :string] "6201")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://gtia.org/policies/code-of-conduct")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "last-revised-date") (option-some-of [:option :string] "2025-02-26")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-16")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn topic-count [a :string i :i64] :i64 (if (valid-entry? a i) 1 0))
(defn topic [a :string i :i64 ti :i64] [:option :string]
  (if (valid-entry? a i)
    (if (= ti 0) (if (= i 0) (option-some-of [:option :string] "governance")
                     (option-some-of [:option :string] "ethics"))
        (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn by-topic-count [a :string t :string] :i64
  (if (association-covered? a) (if (string=? t "governance") 1 (if (string=? t "ethics") 1 0)) 0))
(defn by-topic-id [a :string t :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0) (if (string=? t "governance") (entry-field a 0 "id")
                    (if (string=? t "ethics") (entry-field a 1 "id") (option-none-of [:option :string])))
        (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn main [] :i64 0)
